# Copy this file to ".env" and fill in real values. NEVER commit .env (it is git-ignored).
# See README.md "Configuration" — values here are dev-machine defaults, not production secrets.

DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/pebt_dev
TEST_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/pebt_test

# 32+ random bytes. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_value

# true in production (HTTPS); false ONLY for local non-HTTPS development
COOKIE_SECURE=false

# Backend listen port
PORT=8080
